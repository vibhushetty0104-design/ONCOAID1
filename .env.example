# Public client config only. Never put service-role or AI secrets here.
NEXT_PUBLIC_SITE_URL=https://onco-aid.example
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by app/api/* — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# AI Orchestration Provider (mock | gemini | openai | local | custom)
# Defaults to "mock" if unset or key is missing, providing high-fidelity grounded responses.
AI_PROVIDER=mock
AI_API_KEY=
# AI_BASE_URL=http://localhost:11434/v1 # Optional for Ollama / Local / Groq / OpenAI compatible
# AI_MODEL=gemini-1.5-flash # Optional model override (e.g. gpt-4o-mini, llama3.2)
